+fn raw_web_search_action_detail(action: &codex_protocol::models::WebSearchAction) -> String {
+    match action {
+        codex_protocol::models::WebSearchAction::Search { query, queries } => query
+            .clone()
+            .or_else(|| queries.as_ref().and_then(|queries| queries.first().cloned()))
+            .unwrap_or_default(),
+        codex_protocol::models::WebSearchAction::OpenPage { url } => {
+            url.clone().unwrap_or_default()
+        }
+        codex_protocol::models::WebSearchAction::FindInPage { url, pattern } => {
+            match (pattern.as_deref(), url.as_deref()) {
+                (Some(pattern), Some(url)) => format!("'{pattern}' in {url}"),
+                (Some(pattern), None) => pattern.to_string(),
+                (None, Some(url)) => url.to_string(),
+                (None, None) => String::new(),
+            }
+        }
+        codex_protocol::models::WebSearchAction::Other => String::new(),
+    }
+}
